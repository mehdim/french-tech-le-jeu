            rounds: [Crypto], ticket: (40000000.0, 160000000.0), valuation_mult: 1.0,
            favourite_metric: "La « tokenomics »",
            requires: [MrrAtLeast(1000000.0)],
            on_accept: [SetFlag("crypto_treasury"), Reputation(-6.0), Modifier(kind: LeadMul, value: 1.1, days: 90)],
