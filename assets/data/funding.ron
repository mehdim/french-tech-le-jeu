// Dispositifs de financement public, investisseurs et définitions des tours de table.
// Chaque dispositif est une mécanique de jeu satirique et simplifiée, inspirée de vrais
// dispositifs français. Rien ici ne décrit de vraies conditions d'éligibilité ni de vrais montants.
(
    programs: [
        (
            id: "france_travail", name: "Dossier créateur d'entreprise", institution: "France Travail",
            description: "Déclarer la création, maintenir vos droits, choisir entre ARE et ARCE. Prévoir un rendez-vous, puis un autre.",
            kind: FounderSupport, requires_unlock: Some("france_travail"),
            admin_points: 18.0, wait_days: 6, amount: 0.0, tranches: [], base_success: 0.98, cooldown_days: 0,
            on_approve: [SetFlag("onboarding_done"), TriggerEvent("are_or_arce")],
            approve_text: "France Travail : « Votre dossier est complet. » Vous relisez la phrase trois fois.",
            reject_text: "Votre conseiller a changé. Le nouveau ne retrouve pas votre dossier.",
        ),
        (
            id: "bourse_ft", name: "Bourse French Tech (fictive)", institution: "Bpifrance",
            description: "Subvention d'amorçage de 30 000 €. 70 % à l'accord, 30 % sur justificatifs « dans quelques mois ».",
            kind: Grant, requires_unlock: Some("public_funding"), requires: [Shipped("mvp_text")],
            admin_points: 40.0, wait_days: 30, amount: 30000.0, tranches: [(0, 0.7), (140, 0.3)], base_success: 0.85, cooldown_days: 90,
            approve_text: "Félicitations, votre aide est accordée ! Le versement aura lieu après les prochaines étapes de validation.",
            reject_text: "Bpifrance : « Le caractère innovant du projet n'apparaît pas clairement. » Vous aviez écrit « IA » 42 fois.",
        ),
        (
            id: "pret_amorcage", name: "Prêt d'amorçage", institution: "Bpifrance",
            description: "Prêt de 80 000 € sans garantie personnelle. Six mois de différé, puis 36 mensualités.",
            kind: Loan, requires_unlock: Some("public_funding"), requires: [PayingCustomersAtLeast(10)],
            admin_points: 50.0, wait_days: 30, amount: 80000.0, tranches: [(0, 1.0)], base_success: 0.75, cooldown_days: 120,
            repay_months: 36, grace_months: 6,
            approve_text: "Prêt accordé. Le banquier vous serre la main comme on serre celle d'un futur créancier.",
            reject_text: "« Revenez quand vous aurez plus de traction. » La traction, c'était pour payer la traction.",
        ),
        (
            id: "aide_innovation", name: "Aide pour projet d'innovation", institution: "Bpifrance",
            description: "120 000 € : moitié subvention, moitié avance remboursable. Le dossier fait 46 pages, annexes non comprises.",
            kind: Advance, requires_unlock: Some("public_funding"), requires: [QualityAtLeast(40.0), EmployeesAtLeast(3)],
            admin_points: 85.0, wait_days: 45, amount: 120000.0, tranches: [(0, 0.6), (180, 0.4)], base_success: 0.65, cooldown_days: 150,
            repay_months: 24, grace_months: 12,
            approve_text: "Accordé ! Bpifrance valide votre dossier. Il ne manque plus que 17 justificatifs pour le solde.",
            reject_text: "Refusé. Motif : « budget de l'enveloppe régionale épuisé ». On est en février.",
        ),
        (
            id: "cir", name: "Crédit d'Impôt Recherche", institution: "Administration fiscale",
            description: "30 % de vos dépenses de R&D (salaires sur les projets et chercheurs) remboursés… un jour. Contrôle fiscal possible.",
            kind: TaxCredit, requires_unlock: Some("research"),
            admin_points: 45.0, wait_days: 75, amount: 0.0, tranches: [(0, 1.0)], base_success: 0.88, cooldown_days: 336,
            on_approve: [TriggerEvent("cir_audit_check")],
            approve_text: "Le CIR est remboursé. Un rescrit, un rapport technique de 30 pages, et 3 mois de relances.",
            reject_text: "Le CIR est rejeté : votre rapport technique décrit « une IA qui fait de l'IA ». Le rapporteur n'a pas été convaincu.",
        ),
        (
            id: "jei", name: "Statut Jeune Entreprise Innovante", institution: "URSSAF & impôts",
            description: "Charges patronales réduites (20 % au lieu de 45 %) sur la R&D : chercheurs, backend et fondateur.",
            kind: Status, requires_unlock: Some("research"), requires: [Shipped("eval_dataset")],
            admin_points: 30.0, wait_days: 25, amount: 0.0, tranches: [], base_success: 0.85, cooldown_days: 0,
            approve_text: "Statut JEI obtenu. L'URSSAF vous envoie une lettre recommandée pour vous le confirmer. Vous paniquez quand même en l'ouvrant.",
            reject_text: "JEI refusé : pas assez de dépenses de R&D. Vous aviez trop de commerciaux, apparemment.",
        ),
        (
            id: "deeptech", name: "Aide Deeptech", institution: "Bpifrance",
            description: "250 000 € pour la recherche de rupture. Il faut prouver que c'est vraiment profond.",
            kind: Grant, requires_unlock: Some("advanced_research"), requires: [Shipped("adversarial")],
            admin_points: 120.0, wait_days: 60, amount: 250000.0, tranches: [(0, 0.5), (200, 0.5)], base_success: 0.55, cooldown_days: 400,
            approve_text: "Aide Deeptech accordée. Le comité a particulièrement apprécié le mot « adversarial ».",
            reject_text: "« Trop proche du marché pour du deeptech, trop loin du marché pour de l'innovation. » Kafka approuve.",
        ),
        (
            id: "export", name: "Programme expansion internationale", institution: "Bpifrance & Team France Export",
            description: "200 000 € pour s'attaquer à l'Europe, une délégation à un salon à Berlin, et un kit de cartes de visite bilingues.",
            kind: Grant, requires_unlock: Some("international"), requires: [LanguagesAtLeast(3)],
            admin_points: 80.0, wait_days: 40, amount: 200000.0, tranches: [(0, 1.0)], base_success: 0.65, cooldown_days: 400,
            approve_text: "Programme export validé. On vous a réservé un stand entre une startup de vin connecté et un fabricant de drones.",
            reject_text: "Refusé : « le marché domestique ne semble pas encore saturé ». Vous avez 0,3 % de part de marché.",
        ),
    ],

    rounds: [
        (
            kind: FriendsFamily, name: "Love money", requires_unlock: None, pitch_points: 0.0, dilution: (7.0, 9.0),
            description: "Tante Martine et les cousins. 15 000 € et des questions à chaque repas de famille.",
        ),
        (
            kind: Angels, name: "Business angels", requires_unlock: Some("angels"), pitch_points: 35.0, dilution: (8.0, 16.0),
            description: "Des entrepreneurs qui ont fait fortune avant le haut débit.",
        ),
        (
            kind: Seed, name: "Seed", requires_unlock: Some("seed"), pitch_points: 70.0, dilution: (12.0, 20.0),
            description: "Le premier vrai tour. Un deck de 18 slides, dont 6 sur le marché adressable.",
        ),
        (
            kind: SeriesA, name: "Série A", requires_unlock: Some("vc"), pitch_points: 130.0, dilution: (15.0, 24.0),
            description: "Les fonds veulent de la croissance, des cohortes, et un board.",
        ),
        (
            kind: SeriesB, name: "Série B", requires_unlock: Some("series_b"), pitch_points: 200.0, dilution: (12.0, 20.0),
            description: "On parle en dizaines de millions. Les avocats facturent en centaines de milliers.",
        ),
    ],

    investors: [
        (
            id: "jm_exit2001", name: "Jean-Michel « Exit 2001 »", firm: "Ex-fondateur d'Annuaire-Web.fr",
            bio: "A revendu un annuaire de sites en 2001 juste avant l'éclatement de la bulle. Pense toujours que l'avenir, c'est la bannière publicitaire.",
            rounds: [Angels], ticket: (50000.0, 120000.0), valuation_mult: 0.9,
            favourite_metric: "Le trafic (et les bannières)",
            on_accept: [Modifier(kind: LeadMul, value: 1.15, days: 90), SetFlag("jm_invested")],
            pitch_line: "« Votre truc, là, l'IA… on peut mettre des bannières dessus ? »",
            accept_line: "Jean-Michel signe avec un stylo Montblanc de 1999. « Pensez bannières. »",
            reject_line: "« En 2001, on aurait déjà levé 40 millions. »",
            demand: "Exige un espace bannière sur le dashboard (il a un ami chez une régie).",
        ),
        (
            id: "patrick_blockchain", name: "Patrick Blockchain", firm: "Chain Capital (Luxembourg)",
            bio: "A pivoté de la blockchain au métavers puis à l'IA en 18 mois. Valorise généreusement, demande la tokenisation de tout.",
            rounds: [Angels, Seed], ticket: (80000.0, 200000.0), valuation_mult: 1.3,
            favourite_metric: "Le nombre de wallets connectés",
            on_accept: [SetFlag("patrick_invested")],
            pitch_line: "« Et si chaque détection devenait un NFT ? Réfléchissez-y. Non, vraiment. »",
            accept_line: "Patrick envoie les fonds… en stablecoins. Votre banquier vous appelle.",
            reject_line: "« Vous n'êtes pas assez web3 pour moi. »",
            demand: "Voudra un pivot Web3. Avec insistance.",
        ),
        (
            id: "bernard_ebitda", name: "Bernard EBITDA", firm: "Family office, Neuilly",
            bio: "N'investit pas avant la rentabilité, mais exige 300 % de croissance annuelle. Parle exclusivement en multiples d'EBITDA.",
            rounds: [Angels, Seed], ticket: (100000.0, 250000.0), valuation_mult: 0.75,
            favourite_metric: "L'EBITDA (et rien d'autre)",
            requires: [GrossMarginAtLeast(55.0), RunwayAtLeast(8.0)],
            on_accept: [Modifier(kind: MoraleTarget, value: -3.0, days: 120)],
            pitch_line: "« Votre EBITDA est négatif. Votre croissance est insuffisante. Je suis intéressé. »",
            accept_line: "Bernard investit et vous demande un reporting Excel hebdomadaire. Format .xls, pas .xlsx.",
            reject_line: "« Revenez quand vous gagnerez de l'argent. Mais pas trop tard. »",
            demand: "Reporting hebdomadaire sous Excel. Moral de l'équipe -3 pendant 4 mois.",
        ),
        (
            id: "sophie_termsheet", name: "Sophie Term Sheet", firm: "Ex-avocate M&A, business angel",
            bio: "Comprend parfaitement votre business. Négocie férocement chaque ligne de la term sheet, puis devient votre meilleure alliée.",
            rounds: [Angels, Seed], ticket: (100000.0, 300000.0), valuation_mult: 0.95,
            favourite_metric: "La rétention nette (NRR)",
            requires: [MrrAtLeast(2000.0)],
            on_accept: [Reputation(3.0), Modifier(kind: SalesMul, value: 1.15, days: 120)],
            pitch_line: "« Votre churn est trop haut, votre pricing trop bas, et votre deck a une coquille slide 7. Parlons chiffres. »",
            accept_line: "Sophie signe, puis vous présente trois DSI dans la semaine.",
            reject_line: "« Je ne négocie pas contre moi-même. Bonne chance. »",
            demand: "Préférence de liquidation 1x et siège d'observatrice au board.",
        ),
        (
            id: "cocorico", name: "Cocorico Ventures", firm: "Fonds d'amorçage parisien",
            bio: "Un fonds seed qui a investi dans 40 startups d'IA cette année, dont 12 qui font de la détection d'IA.",
            rounds: [Seed, SeriesA], ticket: (500000.0, 2500000.0), valuation_mult: 1.0,
            favourite_metric: "La croissance MoM",
            requires: [MrrAtLeast(8000.0)],
            on_accept: [Reputation(3.0)],
            pitch_line: "« On adore la thèse. On adore l'équipe. On revient vers vous. »",
            accept_line: "Cocorico Ventures annonce le tour sur LinkedIn avant vous. 4 000 likes.",
            reject_line: "« Pas pour nous à ce stade, mais on garde le contact. »",
        ),
        (
            id: "bastille", name: "Bastille Capital", firm: "Fonds Série A",
            bio: "Associés ex-consultants, data rooms impeccables, process en 14 étapes. Très sérieux.",
            rounds: [SeriesA, SeriesB], ticket: (2000000.0, 6000000.0), valuation_mult: 1.05,
            favourite_metric: "Le burn multiple",
            requires: [MrrAtLeast(40000.0), ChurnBelow(9.0)],
            on_accept: [Reputation(4.0), Modifier(kind: MoraleTarget, value: -2.0, days: 90)],
            pitch_line: "« Pouvez-vous nous envoyer vos cohortes, mensuelles, par segment, depuis le début ? Pour demain ? »",
            accept_line: "Bastille Capital entre au board. Les réunions durent désormais 3 heures.",
            reject_line: "« Votre burn multiple nous inquiète. »",
        ),
        (
            id: "souverain", name: "Fonds Souverain Tricolore", firm: "Fonds public-privé",
            bio: "Investit dans la souveraineté technologique européenne. Demande des engagements d'hébergement en Europe.",
            rounds: [SeriesA, SeriesB], ticket: (3000000.0, 15000000.0), valuation_mult: 0.95,
            favourite_metric: "La part de valeur créée en Europe",
            requires: [MrrAtLeast(50000.0)],
            on_accept: [Reputation(5.0), SetFlag("sovereign_investor")],
            pitch_line: "« Où sont hébergées vos données ? Toutes vos données ? Même les logs ? »",
            accept_line: "Le Fonds Souverain Tricolore entre au capital. Un ministre tweete. Vous êtes « champion européen ».",
            reject_line: "« Revenez quand vous aurez un plan d'hébergement souverain. »",
        ),
        (
            id: "sandhill", name: "Sand Hill Unicorn Partners", firm: "Fonds américain",
            bio: "Chèques énormes, valorisations énormes, attentes énormes. Préférerait que le siège soit au Delaware.",
            rounds: [SeriesA, SeriesB], ticket: (4000000.0, 40000000.0), valuation_mult: 1.35,
            favourite_metric: "Le TAM (en trillions)",
            requires: [MrrAtLeast(60000.0), MrrGrowthStreak(months: 2, min_pct: 6.0)],
            on_accept: [SetFlag("us_investor"), Modifier(kind: LeadMul, value: 1.2, days: 120), Reputation(2.0)],
            pitch_line: "« Love it. Can you be 10x bigger? Also, what's your Delaware story? »",
            accept_line: "Sand Hill entre au capital. Le board se tient désormais à 18h, heure de Paris.",
            reject_line: "« Not venture scale. »",
            demand: "Holding au Delaware et objectif de croissance de 3x par an.",
        ),
        (
            id: "corporate", name: "CAC Ventures", firm: "Fonds corporate d'un grand groupe",
            bio: "Le fonds d'investissement d'un groupe du CAC 40. Investit pour « découvrir l'innovation ». Achète parfois.",
            rounds: [SeriesA, SeriesB], ticket: (1000000.0, 8000000.0), valuation_mult: 0.9,
            favourite_metric: "Les synergies",
            requires: [Unlocked("enterprise")],
            on_accept: [AddCustomers(Enterprise, 2), SetFlag("corporate_investor")],
            pitch_line: "« Nous sommes très intéressés par un POC. Un POC payant ? Hmm. »",
            accept_line: "CAC Ventures investit et vous ouvre deux filiales comme clientes. Le POC durera 18 mois.",
            reject_line: "« Nous allons plutôt le faire en interne. » (Ils ne le feront pas.)",
        ),
    ],
)
