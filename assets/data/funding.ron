            favourite_metric: "Le nombre d'emojis fusée sous vos annonces",
            on_accept: [SetFlag("crypto_treasury"), Reputation(-4.0), Leads(Smb, 60.0)],
            pitch_line: "« gm. Votre détecteur peut-il détecter les rug pulls ? Si oui, wagmi. »",
