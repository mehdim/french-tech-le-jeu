// La campagne en douze niveaux. Objectifs : Reach = acquis une fois atteint ;
// Maintain = doit être vrai quand tous les autres objectifs sont remplis.
[
    (
        id: 1, title: "France Travail Simulator", subtitle: "Niveau 1",
        objective: "Lancez Veridix depuis votre salon : MVP, premiers bêta-testeurs, et survie administrative.",
        intro: [
            (speaker: "Narrateur", text: "Paris, un lundi de novembre. Vous venez de démissionner de votre poste de CTO. Votre post LinkedIn « Nouvelle aventure 🚀 » fait 3 400 likes."),
            (speaker: "Vous", text: "Veridix. Une IA qui détecte les contenus générés par IA. Les profs en ont besoin, les médias en ont besoin, la démocratie en a besoin."),
            (speaker: "Votre conseillère France Travail", text: "Très bien. Vous créez une entreprise. Vous avez le formulaire de déclaration ? Non, pas celui-là. L'autre. Celui qui n'existe plus."),
            (speaker: "Vous", text: "Le classifieur actuel est à 53 % de précision. C'est mieux qu'une pièce de monnaie. Un peu."),
            (speaker: "Narrateur", text: "Affectez-vous à une tâche (cliquez sur votre personnage), lancez le MVP depuis le panneau Produit, et n'oubliez pas le dossier France Travail dans Financement."),
        ],
        quests: [
            (id: "onboarding", label: "Compléter l'onboarding France Travail", kind: Reach, condition: Flag("onboarding_done"),
             hint: "Financement → Dossier créateur, puis affectez-vous à « Administratif »."),
            (id: "mvp", label: "Construire le premier MVP", kind: Reach, condition: Shipped("mvp_text"),
             hint: "Produit → Détection de texte (MVP), puis affectez-vous à la tâche."),
            (id: "beta", label: "Trouver 3 bêta-testeurs", kind: Reach, condition: CustomersAtLeast(3),
             hint: "Après le MVP, passez du temps en Ventes ou Marketing."),
            (id: "cash", label: "Garder plus de 5 000 € en banque", kind: Maintain, condition: CashAtLeast(5000.0),
             hint: "Chaque tâche a un coût. Ne dépensez pas tout en GPU."),
        ],
        unlocks: ["product_dev", "france_travail"],
        unlock_text: ["Développement produit", "Accompagnement France Travail"],
        boss_event: "page4", boss_trigger: Day(4),
        start_effects: [TriggerEvent("mentors_intro")],
        failure_risk: "Trésorerie à zéro : retour au CDI.",
        outro: [
            (speaker: "Narrateur", text: "Trois bêta-testeurs : un lycée de Montreuil, une journaliste pigiste et votre ancienne prof de philo."),
            (speaker: "Vous", text: "Le MVP marche. Enfin, il marche quand on ne lui donne pas de poèmes. Il pense que Baudelaire est un LLM."),
        ],
    ),
    (
        id: 2, title: "Le Garage à 1 400 € par mois", subtitle: "Niveau 2",
        objective: "Installez-vous en coworking, recrutez, lancez la version payante.",
        intro: [
            (speaker: "Narrateur", text: "Votre salon ne suffit plus. Vous signez pour deux postes dans un coworking du 11e : « Le Garage ». Ni garage, ni voiture, mais du kombucha."),
            (speaker: "Le gérant du coworking", text: "1 400 € par mois, Wi-Fi inclus, sauf entre 15h et 16h. Et on fait un afterwork tous les jeudis, c'est obligatoire-mais-pas-obligatoire."),
            (speaker: "Vous", text: "Il est temps de recruter. Et de faire payer les clients. Dans cet ordre ? Dans l'autre ?"),
            (speaker: "Narrateur", text: "Le recrutement est débloqué (panneau Équipe) et vous pouvez placer du mobilier (panneau Bureau). Le produit doit sortir de la bêta : tâche « Lancement public »."),
        ],
        quests: [
            (id: "hire", label: "Recruter un·e premier·e ingénieur·e", kind: Reach,
             condition: Any([RoleAtLeast(Backend, 1), RoleAtLeast(Frontend, 1), RoleAtLeast(AiResearcher, 1), RoleAtLeast(DevOps, 1), RoleAtLeast(Consultant, 1)]),
             hint: "Équipe → Recruter. LinkedIn est rapide, France Travail est gratuit mais lent."),
            (id: "launch", label: "Lancer le produit (fin de la bêta gratuite)", kind: Reach, condition: Shipped("launch"),
             hint: "Il faut d'abord le dashboard."),
            (id: "customers", label: "Atteindre 20 clients payants", kind: Reach, condition: PayingCustomersAtLeast(20),
             hint: "Ventes, marketing, budget pub : tout aide."),
            (id: "mrr", label: "Générer 500 € de MRR", kind: Reach, condition: MrrAtLeast(500.0),
             hint: "MRR = clients × prix mensuel."),
        ],
        unlocks: ["launch", "recruitment", "office_custom"],
        unlock_text: ["Lancement commercial et tarification", "Recrutement", "Aménagement du bureau"],
        boss_event: "landlord", boss_trigger: Day(24),
        min_office: Some(1),
        failure_risk: "Recruter trop tôt et trop cher épuise la trésorerie en quelques mois.",
        outro: [
            (speaker: "Narrateur", text: "500 € de MRR. Vous faites une capture d'écran du dashboard Stripe. Vous la postez. Vous la supprimez. Vous la repostez."),
            (speaker: "Vous", text: "On a un produit, des clients, une équipe. Il nous manque juste… de l'argent."),
        ],
    ),
    (
        id: 3, title: "BPI, Mon Amour", subtitle: "Niveau 3",
        objective: "Financez la R&D : dossiers publics, qualité produit, premiers vrais clients.",
        intro: [
            (speaker: "Narrateur", text: "Votre chargée d'affaires Bpifrance s'appelle Nathalie. Elle est bienveillante, compétente, et elle a besoin de votre prévisionnel. Encore."),
            (speaker: "Nathalie (Bpifrance)", text: "Le projet est très intéressant. Pouvez-vous détailler la partie « verrou technologique » ? Et ajouter un diagramme de Gantt ?"),
            (speaker: "Vous", text: "Le verrou technologique, c'est que personne ne sait si ce problème a une solution."),
            (speaker: "Nathalie (Bpifrance)", text: "Parfait, mettez ça en annexe 4."),
            (speaker: "Narrateur", text: "Nouveaux dossiers dans Financement (Bourse, prêt, aide à l'innovation, CIR, JEI). L'arbre de recherche s'agrandit. Un incubateur vous ouvre ses portes (panneau Bureau)."),
        ],
        quests: [
            (id: "application", label: "Déposer un dossier de financement R&D", kind: Reach, condition: ApplicationSubmittedInLevel,
             hint: "Lancez un dossier, puis affectez quelqu'un à « Administratif »."),
            (id: "customers", label: "Atteindre 60 clients payants", kind: Reach, condition: PayingCustomersAtLeast(60)),
            (id: "quality", label: "Qualité produit ≥ 55/100", kind: Reach, condition: QualityAtLeast(55.0),
             hint: "Qualité = fonctionnalités + détection (précision, faux positifs) + fiabilité."),
            (id: "funding", label: "Sécuriser 50 000 € de financement", kind: Reach, condition: FundingSecuredInLevelAtLeast(50000.0),
             hint: "Aides accordées, prêts et love money comptent."),
        ],
        unlocks: ["public_funding", "research", "office_t2"],
        unlock_text: ["Financements publics (Bpifrance, CIR, JEI)", "Recherche avancée", "Incubateur"],
        boss_event: "projections_v7", boss_trigger: Day(12),
        failure_risk: "L'argent public arrive tard. Très tard. Surveillez la trésorerie en attendant.",
        outro: [
            (speaker: "Nathalie (Bpifrance)", text: "Félicitations. Le versement du solde interviendra sur présentation de l'état récapitulatif des dépenses, certifié, signé, tamponné."),
            (speaker: "Vous", text: "Il faut un tampon ? On est une startup d'IA. On n'a pas de tampon."),
            (speaker: "Narrateur", text: "Vous commandez un tampon en ligne. 14,90 €. Meilleur investissement de l'année."),
        ],
    ),
    (
        id: 4, title: "Les Business Angels du Minitel", subtitle: "Niveau 4",
        objective: "Levez auprès de business angels sans brader votre capital, et structurez la vente.",
        intro: [
            (speaker: "Narrateur", text: "Un dîner de business angels dans un club du 8e. Moyenne d'âge : 61 ans. Moyenne de connexion à LinkedIn : une fois par mois, pour accepter des invitations."),
            (speaker: "Jean-Michel « Exit 2001 »", text: "En 2001, j'ai vendu un annuaire de sites web pour 40 millions de francs. Votre truc, on peut mettre des bannières dessus ?"),
            (speaker: "Sophie Term Sheet", text: "Votre churn est à deux chiffres. Je vous écoute quand même, mais on va parler de préférence de liquidation."),
            (speaker: "Narrateur", text: "Panneau Financement : lancez un tour « Business angels » et affectez-vous à « Levée de fonds ». La table de capitalisation est visible. Recrutez un·e commercial·e."),
        ],
        quests: [
            (id: "mrr", label: "Atteindre 5 000 € de MRR", kind: Reach, condition: MrrAtLeast(5000.0)),
            (id: "sales", label: "Recruter un·e commercial·e", kind: Reach, condition: RoleAtLeast(Sales, 1)),
            (id: "churn", label: "Churn mensuel sous 12 %", kind: Maintain, condition: ChurnBelow(12.0),
             hint: "Qualité, faux positifs, prix et rétention produit jouent sur le churn."),
            (id: "angels", label: "Lever ≥ 50 k€ en gardant ≥ 70 % du capital", kind: Reach,
             condition: All([EquityRaisedInLevelAtLeast(50000.0), FounderEquityAtLeast(70.0)])),
        ],
        unlocks: ["angels", "cap_table"],
        unlock_text: ["Business angels", "Table de capitalisation"],
        boss_event: "web3_pivot", boss_trigger: Day(20),
        failure_risk: "Une levée trop diluante, et le reste de la partie se joue avec 30 % de votre propre boîte.",
        outro: [
            (speaker: "Narrateur", text: "Les angels sont à bord. Le groupe WhatsApp « Veridix Investors 🚀 » compte 9 membres et reçoit 40 messages par jour, dont 38 sur la blockchain."),
        ],
    ),
    (
        id: 5, title: "Product-Market Fit, Enfin Presque", subtitle: "Niveau 5",
        objective: "Segmentez, réduisez le churn, et livrez des améliorations qui comptent.",
        intro: [
            (speaker: "Narrateur", text: "Quelque chose change. Les clients reviennent. Ils envoient des feature requests au lieu de demandes de remboursement."),
            (speaker: "Une rédactrice en chef", text: "On a 300 pigistes. On veut l'API, le traitement par lots, et un tarif média. Vous avez un tarif média ?"),
            (speaker: "Vous", text: "Oui. Depuis trente secondes."),
            (speaker: "Narrateur", text: "Nouveau segment « Médias & universités » (il exige clés d'API et traitement par lots). Analytics avancés débloqués. Des bureaux à Paris deviennent disponibles."),
        ],
        quests: [
            (id: "mrr", label: "Atteindre 15 000 € de MRR", kind: Reach, condition: MrrAtLeast(15000.0)),
            (id: "customers", label: "200 clients payants", kind: Reach, condition: PayingCustomersAtLeast(200)),
            (id: "churn", label: "Churn mensuel sous 8 %", kind: Maintain, condition: ChurnBelow(8.0)),
            (id: "ship", label: "Livrer 3 améliorations produit", kind: Reach, condition: ShippedInLevelAtLeast(3)),
        ],
        unlocks: ["segmentation", "analytics", "office_t3"],
        unlock_text: ["Segment Médias & universités", "Analytics avancés", "Bureaux Paris 10e"],
        boss_event: "free_competitor", boss_trigger: Day(30),
        failure_risk: "Croître sans retenir : vous remplissez une baignoire sans bouchon.",
        outro: [
            (speaker: "Narrateur", text: "Un tweet viral d'un prof : « Veridix ne m'a jamais accusé à tort. » 2 millions de vues. Votre CTO (vous) pleure un peu."),
        ],
    ),
    (
        id: 6, title: "Station F et Machine à Café", subtitle: "Niveau 6",
        objective: "Grandissez sans casser l'équipe : 8 personnes, du moral, et de la trésorerie.",
        intro: [
            (speaker: "Narrateur", text: "Un campus géant vous accepte : « Station Effe ». 1 000 startups, une halle ferroviaire, un ministre tous les mardis et des pitchs dans la file du micro-ondes."),
            (speaker: "Un founder voisin", text: "Vous faites de la détection d'IA ? Nous aussi ! Et eux. Et eux. Et le stand là-bas, c'est un générateur de textes indétectables."),
            (speaker: "Vous", text: "Il faut une vraie équipe. Des départements. Et une machine à café qui tient la charge."),
            (speaker: "Narrateur", text: "Le campus et le tour Seed sont débloqués. Attention au moral et au runway pendant la croissance."),
        ],
        quests: [
            (id: "team", label: "Passer à 8 personnes", kind: Reach, condition: EmployeesAtLeast(8)),
            (id: "mrr", label: "Atteindre 30 000 € de MRR", kind: Reach, condition: MrrAtLeast(30000.0)),
            (id: "morale", label: "Moral moyen ≥ 65/100", kind: Maintain, condition: MoraleAtLeast(65.0),
             hint: "Mobilier, bureaux, pas de crunch, dette technique sous contrôle, RH."),
            (id: "runway", label: "Garder plus de 6 mois de runway", kind: Maintain, condition: RunwayAtLeast(6.0)),
        ],
        unlocks: ["seed", "office_t4", "departments"],
        unlock_text: ["Tour Seed", "Campus Station Effe", "Départements"],
        boss_event: "devops_quits", boss_trigger: Day(20),
        failure_risk: "Embaucher trop vite fait fondre le runway ; trop lentement, le moral s'effondre sous la charge.",
        outro: [
            (speaker: "Narrateur", text: "Huit personnes, un vrai moral, un vrai runway. Un ministre visite votre stand et vous appelle « Verydix ». Vous ne corrigez pas."),
        ],
    ),
    (
        id: 7, title: "L'IA va tout Disrupter", subtitle: "Niveau 7",
        objective: "Un nouveau modèle de fondation casse votre détecteur. Reconstruisez la fiabilité.",
        intro: [
            (speaker: "Narrateur", text: "Un laboratoire américain sort un modèle de fondation qui écrit comme un humain fatigué un dimanche soir. Votre précision s'effondre en une nuit."),
            (speaker: "Votre chercheuse", text: "Le benchmark est mort. Nos jeux d'évaluation sont tous contaminés. Et on flagge maintenant les mails de la DRH comme générés par IA."),
            (speaker: "Vous", text: "…ils le sont peut-être."),
            (speaker: "Narrateur", text: "Recherche avancée débloquée : nouveau benchmark, robustesse adversariale, watermarks, méthodes hybrides. Les clients surveillent."),
        ],
        start_effects: [Drift(14.0), Fpr(1.5), InferenceCostMul(1.2), Modifier(kind: ChurnAdd, value: 1.5, days: 60)],
        quests: [
            (id: "datasets", label: "Reconstruire les jeux d'évaluation", kind: Reach, condition: Shipped("benchmark_v2")),
            (id: "accuracy", label: "Restaurer la précision ≥ 80 %", kind: Reach, condition: AccuracyAtLeast(80.0),
             hint: "Réentraînement, benchmark, robustesse, méthodes hybrides."),
            (id: "fpr", label: "Faux positifs ≤ 4 %", kind: Reach, condition: FprAtMost(4.0)),
            (id: "keep", label: "Garder 80 % des clients payants", kind: Maintain, condition: CustomersRetainedPct(80.0)),
        ],
        unlocks: ["advanced_research"],
        unlock_text: ["R&D avancée et tests adversariaux"],
        boss_event: "benchmark_theater", boss_trigger: Day(25),
        failure_risk: "La dérive continue : sans réentraînement régulier, la précision fond chaque semaine.",
        outro: [
            (speaker: "Votre chercheuse", text: "On est revenus. Pas à 100 % — personne ne le sera jamais. Mais on sait maintenant mesurer ce qu'on ne sait pas."),
            (speaker: "Narrateur", text: "Vous publiez un article honnête sur les limites de la détection. Il fait plus de leads que tous vos posts LinkedIn réunis."),
        ],
    ),
    (
        id: 8, title: "La Série A du PowerPoint", subtitle: "Niveau 8",
        objective: "Levez 3 M€ sans perdre plus de 25 % : croissance, marges, et un board à convaincre.",
        intro: [
            (speaker: "Narrateur", text: "Votre deck fait 34 slides. Le slide « Vision » contient le mot « plateforme » quatre fois. Le slide « Concurrence » est un carré magique où vous êtes seul en haut à droite."),
            (speaker: "Un associé de fonds", text: "On adore. Vraiment. Pouvez-vous nous envoyer les cohortes, le burn multiple, le CAC payback, la NRR et le plan d'embauche à 36 mois ? Pour demain ?"),
            (speaker: "Narrateur", text: "Tour Série A débloqué. Les fonds regardent la croissance sur plusieurs mois et la marge brute."),
        ],
        quests: [
            (id: "mrr", label: "Atteindre 75 000 € de MRR", kind: Reach, condition: MrrAtLeast(75000.0)),
            (id: "growth", label: "Croissance soutenue : +5 %/mois en moyenne sur 3 mois", kind: Reach, condition: MrrGrowthStreak(months: 3, min_pct: 5.0)),
            (id: "margin", label: "Marge brute ≥ 65 %", kind: Maintain, condition: GrossMarginAtLeast(65.0),
             hint: "Optimisez l'inférence : rate limiting, distillation, infra dédiée."),
            (id: "raise", label: "Lever ≥ 3 M€ avec ≤ 25 % de dilution", kind: Reach,
             condition: RoundClosedInLevel(min_amount: 3000000.0, max_dilution: 25.0)),
        ],
        unlocks: ["vc"],
        unlock_text: ["Capital-risque et attentes du board"],
        boss_event: "bp_48h", boss_trigger: Day(15),
        failure_risk: "Une valorisation trop basse vous force à diluer au-delà du raisonnable.",
        outro: [
            (speaker: "Narrateur", text: "« Veridix lève 3 millions d'euros pour résoudre un problème dont personne ne connaît la définition. » — Maddyness, probablement."),
            (speaker: "Vous", text: "On a de l'argent. Maintenant, il faut le dépenser intelligemment. Ce qui est beaucoup plus dur."),
        ],
    ),
    (
        id: 9, title: "L'Enterprise Sales Hell", subtitle: "Niveau 9",
        objective: "Signez les grands comptes : SSO, audit, RGPD, et des cycles de vente de neuf mois.",
        intro: [
            (speaker: "Narrateur", text: "Un grand groupe du CAC 40 veut Veridix. Il faut juste passer le questionnaire sécurité (412 questions), le comité achats, le comité juridique et le comité du comité."),
            (speaker: "La DSI d'un grand groupe", text: "SSO, journaux d'audit, RGPD, hébergement en France, réversibilité, SLA. Et la démo, c'est possible sans Internet ?"),
            (speaker: "Narrateur", text: "Segment « Grands comptes » débloqué (il exige SSO, journaux d'audit et RGPD). Un QG européen devient disponible."),
        ],
        quests: [
            (id: "accounts", label: "Signer 5 grands comptes", kind: Reach, condition: SegmentCustomersAtLeast(Enterprise, 5)),
            (id: "features", label: "Livrer le SSO et les journaux d'audit", kind: Reach, condition: All([Shipped("sso"), Shipped("audit_logs")])),
            (id: "churn", label: "Churn grands comptes sous 3 %", kind: Maintain, condition: SegmentChurnBelow(Enterprise, 3.0)),
            (id: "mrr", label: "Atteindre 150 000 € de MRR", kind: Reach, condition: MrrAtLeast(150000.0)),
        ],
        unlocks: ["enterprise", "office_t5"],
        unlock_text: ["Ventes grands comptes, achats et conformité", "QG européen"],
        boss_event: "gdpr_discount", boss_trigger: When(SegmentCustomersAtLeast(Enterprise, 2)),
        failure_risk: "Les grands comptes paient bien mais tard, et chaque fonctionnalité promise coûte des mois.",
        outro: [
            (speaker: "Narrateur", text: "Cinq grands comptes. Le premier a payé sa facture avec 120 jours de retard, « conformément à la procédure fournisseurs »."),
        ],
    ),
    (
        id: 10, title: "La RAMpocalypse", subtitle: "Niveau 10",
        objective: "Les coûts d'infrastructure IA explosent. Optimisez ou mourez (lentement, avec une belle facture).",
        intro: [
            (speaker: "Narrateur", text: "Pénurie mondiale de mémoire HBM. Le prix des GPU triple. Votre facture cloud aussi, avec un léger décalage pour l'effet de surprise."),
            (speaker: "Votre CFO", text: "On perd plus d'argent avec un million d'euros de chiffre d'affaires qu'avec cent mille. Comment c'est possible ?"),
            (speaker: "Vous", text: "Ça s'appelle le scale."),
            (speaker: "Narrateur", text: "Optimisation débloquée : quantization, modèle compact maison, migration GPU européens, serveurs GPU au bureau."),
        ],
        start_effects: [InferenceCostMul(1.3)],
        quests: [
            (id: "cost", label: "Réduire le coût d'inférence de 35 %", kind: Reach, condition: InferenceCostReducedBy(0.35),
             hint: "Par rapport au début du niveau. Quantization, modèle compact, GPU dédiés, serveurs GPU."),
            (id: "margin", label: "Marge brute ≥ 75 %", kind: Maintain, condition: GrossMarginAtLeast(75.0)),
            (id: "model", label: "Déployer un modèle plus efficace", kind: Reach, condition: Shipped("small_model")),
            (id: "mrr", label: "Atteindre 250 000 € de MRR", kind: Reach, condition: MrrAtLeast(250000.0)),
        ],
        unlocks: ["optimization"],
        unlock_text: ["Optimisation des modèles, stratégie d'hébergement, GPU"],
        boss_event: "cloud_pricing", boss_trigger: Day(20),
        failure_risk: "Chaque nouveau client coûte plus cher à servir : grandir sans optimiser creuse les pertes.",
        outro: [
            (speaker: "Narrateur", text: "Votre modèle compact fait 300 millions de paramètres et bat le modèle géant de l'an dernier sur votre tâche. Le dernier ingénieur à en douter est parti chez un hyperscaler."),
        ],
    ),
    (
        id: 11, title: "Make Europe Great Again, Technologically", subtitle: "Niveau 11",
        objective: "Choisissez votre stratégie internationale et d'infrastructure, puis conquérez l'Europe.",
        intro: [
            (speaker: "Narrateur", text: "Bruxelles parle de souveraineté numérique. Berlin parle de Datenschutz. Madrid parle de vous. Washington parle de prix cassés."),
            (speaker: "Un commissaire européen (dans un panel)", text: "L'Europe doit avoir ses champions. Dans neuf mois, après l'appel d'offres. Ou douze."),
            (speaker: "Narrateur", text: "Internationalisation, Série B et pivot « IA native » débloqués. Il faut des langues, des marchés et une décision d'infrastructure."),
        ],
        start_effects: [TriggerEvent("infra_choice")],
        quests: [
            (id: "markets", label: "S'implanter dans 3 marchés européens", kind: Reach, condition: MarketsAtLeast(4)),
            (id: "mrr", label: "Atteindre 500 000 € de MRR", kind: Reach, condition: MrrAtLeast(500000.0)),
            (id: "langs", label: "Support multilingue (6 langues)", kind: Reach, condition: LanguagesAtLeast(6)),
            (id: "infra", label: "Choisir sa stratégie d'infrastructure", kind: Reach, condition: Flag("infra_choice")),
        ],
        unlocks: ["international", "series_b", "ai_native"],
        unlock_text: ["Internationalisation", "Série B", "Pivot IA native (provenance, agents, plateforme de confiance)"],
        boss_event: "us_undercut", boss_trigger: Day(30),
        failure_risk: "Ouvrir des marchés coûte cher avant de rapporter, et les achats publics européens sont lents.",
        outro: [
            (speaker: "Narrateur", text: "Veridix parle six langues. Le modèle aussi. Le CEO, toujours deux, mais avec beaucoup d'assurance."),
        ],
    ),
    (
        id: 12, title: "Licorne ou Poney ?", subtitle: "Niveau 12",
        objective: "Atteignez 1 M€ de MRR avec des unit economics saines et la confiance des clients, puis décidez de l'avenir de Veridix.",
        intro: [
            (speaker: "Narrateur", text: "Le dernier chapitre. Les banquiers d'affaires appellent. Les fonds américains appellent. Votre mère appelle (elle a vu un article)."),
            (speaker: "Vous", text: "Un million de MRR. Des marges propres. Des clients qui nous font confiance. Et ensuite ?"),
            (speaker: "Narrateur", text: "Quand les trois premiers objectifs sont atteints, la décision finale s'ouvre : Licorne, Rentabilité, Rachat, ou Communs."),
        ],
        quests: [
            (id: "mrr", label: "Atteindre 1 000 000 € de MRR", kind: Reach, condition: MrrAtLeast(1000000.0)),
