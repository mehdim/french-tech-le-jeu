// Segments de clientèle, marchés géographiques et fins de campagne.
(
    segments: [
        (
            segment: Smb, name: "PME, écoles & freelances",
            default_price: 49.0, reference_price: 49.0, min_price: 9.0, max_price: 299.0,
            elasticity: 1.2, base_conversion: 0.22, sales_effort: 1.0, base_churn: 5.5,
            usage: 4000.0, cost_per_lead: 35.0, requires_unlock: None,
            required_features: ["mvp_text"], tam_per_market: 7000.0,
        ),
        (
            segment: Mid, name: "Médias & universités",
            default_price: 490.0, reference_price: 490.0, min_price: 99.0, max_price: 2990.0,
            elasticity: 1.0, base_conversion: 0.12, sales_effort: 5.0, base_churn: 3.2,
            usage: 40000.0, cost_per_lead: 250.0, requires_unlock: Some("segmentation"),
            required_features: ["api_keys", "batch"], tam_per_market: 1800.0,
        ),
        (
            segment: Enterprise, name: "Grands comptes & administrations",
            default_price: 6000.0, reference_price: 6000.0, min_price: 1500.0, max_price: 30000.0,
            elasticity: 0.8, base_conversion: 0.11, sales_effort: 28.0, base_churn: 1.1,
            usage: 400000.0, cost_per_lead: 3000.0, requires_unlock: Some("enterprise"),
            required_features: ["sso", "audit_logs", "gdpr"], tam_per_market: 350.0,
        ),
    ],

    markets: [
        (id: "fr", name: "France", flag: "FR", cost: 0.0, languages_required: 1, lead_mult: 1.0,
         description: "Le marché domestique. 67 millions d'habitants, 12 000 startups d'IA."),
        (id: "de", name: "Allemagne", flag: "DE", cost: 60000.0, languages_required: 3, lead_mult: 0.7,
         description: "Grands comptes exigeants, procurement interminable, Datenschutz partout."),
        (id: "es", name: "Espagne", flag: "ES", cost: 40000.0, languages_required: 3, lead_mult: 0.45,
         description: "Universités nombreuses, médias très actifs, budgets plus serrés."),
        (id: "benelux", name: "Benelux", flag: "BE", cost: 35000.0, languages_required: 1, lead_mult: 0.4,
         description: "Francophones, néerlandophones, et des institutions européennes à Bruxelles."),
        (id: "it", name: "Italie", flag: "IT", cost: 45000.0, languages_required: 6, lead_mult: 0.45,
         description: "Un marché éditorial énorme et des PME très attachées au fax."),
        (id: "nordics", name: "Pays nordiques", flag: "SE", cost: 50000.0, languages_required: 6, lead_mult: 0.35,
         description: "Adoption rapide, salaires élevés, et des clients qui lisent vraiment les CGU."),
        (id: "us", name: "États-Unis (filiale de San Francisco)", flag: "US", cost: 900000.0, monthly_cost: 90000.0,
         languages_required: 1, lead_mult: 3.0, requires_unlock: Some("usa"),
         description: "Le plus gros marché du monde. Bureaux à SoMa, avocats à Palo Alto, holding au Delaware. Tout coûte trois fois plus cher, y compris les clients."),
        (id: "cn", name: "Chine (bureau de Shanghai)", flag: "CN", cost: 700000.0, monthly_cost: 60000.0,
         languages_required: 7, lead_mult: 1.3, requires_unlock: Some("china"),
         description: "Des fabricants de modèles par dizaines, un régulateur qui exige le marquage des contenus générés, et des concurrents qui copient vite."),
        (id: "jp", name: "Japon", flag: "JP", cost: 400000.0, monthly_cost: 30000.0,
         languages_required: 7, lead_mult: 0.9, requires_unlock: Some("world"),
         description: "Des grands comptes fidèles pour vingt ans, après dix-huit mois de réunions de consensus (nemawashi)."),
        (id: "in", name: "Inde", flag: "IN", cost: 300000.0, monthly_cost: 20000.0,
         languages_required: 7, lead_mult: 1.1, requires_unlock: Some("world"),
         description: "Des universités immenses, des examens nationaux à des millions de candidats, et une négociation tarifaire de haut niveau."),
        (id: "br", name: "Brésil", flag: "BR", cost: 300000.0, monthly_cost: 20000.0,
         languages_required: 7, lead_mult: 0.7, requires_unlock: Some("world"),
         description: "Des médias très actifs, une élection tous les deux ans, et beaucoup de deepfakes à détecter."),
        (id: "gulf", name: "Pays du Golfe", flag: "AE", cost: 350000.0, monthly_cost: 25000.0,
         languages_required: 7, lead_mult: 0.5, requires_unlock: Some("world"),
         description: "Des fonds souverains, des villes nouvelles et des appels d'offres où la démo se fait devant un ministre."),
    ],

    endings: [
        (
            id: "unicorn", title: "La Licorne Mondiale",
            requires: [Flag("series_c_done"), ReputationAtLeast(45.0)],
            requirement_text: "Série C bouclée et réputation ≥ 45",
            headline: "« Veridix lève une Série C géante et vaut désormais plus que l'ensemble du CAC Small. Personne ne sait vraiment comment. »",
            art: "ending_unicorn",
            epilogue: [
                (speaker: "Les Échos", text: "Veridix devient la licorne française la mieux valorisée. Le communiqué contient 14 fois le mot « souveraineté » et 0 fois le mot « rentabilité »."),
                (speaker: "Vous", text: "On va recruter 2 000 personnes, ouvrir Singapour et sponsoriser une équipe de e-sport. Pourquoi ? Parce qu'on peut."),
                (speaker: "Le board", text: "Excellent. Maintenant, il faut tripler l'ARR en 18 mois pour justifier la valorisation."),
                (speaker: "Narrateur", text: "Deux ans plus tard, Veridix publie un post LinkedIn : « Nous avons pris la décision difficile de nous recentrer. » Les ingénieurs, eux, fondent trois startups excellentes."),
            ],
        ),
        (
            id: "ipo", title: "L'Introduction en Bourse",
            requires: [Shipped("ipo_readiness")],
            requirement_text: "Préparation à l'IPO livrée",
            headline: "« VRDX : premier jour de cotation, +38 %. Le fondateur sonne la cloche avec un pull en laine de Belleville. »",
            art: "ending_ipo",
            epilogue: [
                (speaker: "Un analyste financier", text: "Achat fort. Le marché adore les entreprises qui vérifient l'authenticité de choses. Surtout celles des autres."),
                (speaker: "Vous", text: "Tous les salariés ont des actions. La stagiaire de 2024 peut s'acheter un appartement. Un petit. À Saint-Étienne."),
                (speaker: "Votre CFO", text: "Désormais, on publie nos résultats tous les trimestres. Pendant trois semaines par trimestre, personne ne dort."),
                (speaker: "Narrateur", text: "Veridix reste indépendante, cotée, européenne. Le cours fait des montagnes russes à chaque nouveau modèle de fondation. Comme le moral du fondateur."),
            ],
        ),
        (
            id: "profitable", title: "La Boîte Rentable",
            requires: [NetBurnAtMost(0.0)],
            requirement_text: "Être rentable (burn net ≤ 0)",
            headline: "« Veridix, rentable, sobre et indépendante, ne fait la une d'aucun média. Elle s'en porte très bien. »",
            art: "ending_profitable",
            epilogue: [
                (speaker: "Vous", text: "On a décidé de ne plus lever. On vend un produit, des clients le paient, on paie nos salaires et notre électricité. Révolutionnaire."),
                (speaker: "Bernard EBITDA", text: "Enfin ! Un EBITDA positif ! Je… je crois que je vais pleurer."),
                (speaker: "Les VC", text: "« Ce n'est pas venture scale. » (Ils ont raison. Personne ne se plaint.)"),
                (speaker: "Narrateur", text: "Veridix paie ses impôts en France, chauffe une piscine municipale, et sa machine à café a enfin un contrat de maintenance. Fièrement européenne."),
            ],
        ),
        (
            id: "acquisition", title: "Le Rachat par NVIDIA",
            requires: [Flag("nvidia_interest")],
            requirement_text: "Avoir écouté l'offre de NVIDIA à Davos",
            headline: "« NVIDIA rachète Veridix. Le produit sera « intégré à la plateforme » (traduction : il tournera très, très vite). »",
            art: "ending_acquisition",
            epilogue: [
                (speaker: "Un vice-président de NVIDIA", text: "We're thrilled to welcome the Veridix team! Every GPU will now ship with authenticity built in."),
                (speaker: "Vous", text: "Earn-out de quatre ans, badge vert, et une partie du prix payée en GPU. Notre ancien fournisseur devient notre employeur."),
                (speaker: "Narrateur", text: "Un ministre déplore « la fuite de nos pépites ». Le même ministre avait refusé de vous recevoir au niveau 3."),
                (speaker: "Narrateur", text: "Vous êtes riche, un peu triste, et vous avez déjà un nouveau projet de startup sur un coin de nappe."),
            ],
        ),
        (
            id: "commons", title: "Les Communs",
            requires: [ReputationAtLeast(60.0)],
            requirement_text: "Réputation ≥ 60",
            headline: "« Veridix ouvre son benchmark et ses modèles sous licence libre. Le monde de la recherche applaudit. Le CFO respire dans un sac en papier. »",
            art: "ending_commons",
            epilogue: [
                (speaker: "Vous", text: "La détection universelle n'existe pas. Alors on publie tout : le benchmark, les modèles, les échecs, et nos mesures de consommation d'énergie. Et on vend le support, l'hébergement souverain et le service."),
                (speaker: "La communauté", text: "Deux cents contributeurs en un mois. Un chercheur de Tampere divise la consommation du modèle par deux en une ligne."),
                (speaker: "Narrateur", text: "Veridix devient l'infrastructure de confiance de l'écosystème européen. Modèle commercial durable, communauté vivante, et un stand au FOSDEM."),
                (speaker: "Narrateur", text: "Finalement, peut-être que la vraie licorne, c'était les ingénieurs qu'on a rencontrés en chemin."),
            ],
        ),
    ],
)
