            (label: "Se mettre en conformité (2 M€ d'avocats)", effects: [Cash(-2000000.0), Reputation(2.0), AdminPoints(60.0)],
             outcome: "Votre jeton devient le plus réglementé d'Europe. Il intéresse beaucoup moins de monde."),
            (label: "Tout convertir en euros et tourner la page", effects: [CryptoSell(0.04), Reputation(1.0)],
             outcome: "Fin de l'aventure crypto. Vos investisseurs de la DAO votent une motion de défiance sur Discord. Elle n'a aucun effet juridique."),
            (label: "Plaider le « jeton utilitaire »", effects: [Reputation(-6.0), Modifier(kind: ChurnAdd, value: 0.8, days: 120)],
             outcome: "Le jeton sert, selon vous, à « payer des analyses ». Personne n'a jamais payé une analyse avec. L'AMF le note."),
        ],
        art: "bureaucracy",
    ),
    (
        id: "crypto_market_maker", title: "Le teneur de marché disparaît", weight: 1.0, once: true,
        conditions: [Flag("crypto_treasury")],
        speaker: "Votre CFO",
        description: "Le teneur de marché censé assurer la liquidité du jeton VRDX a fermé son site, son compte et son bureau (qui était un espace de coworking à Lisbonne). Le jeton perd la moitié de sa valeur en une journée.",
