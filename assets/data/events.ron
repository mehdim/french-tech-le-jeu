    (
        id: "takeover_google", scripted: true, title: "Offre de rachat : Google",
        speaker: "Ada Rankwell, vice-présidente des acquisitions de Google",
        description: "Ada Rankwell, vice-présidente des acquisitions de Google, vous invite à déjeuner dans un restaurant étoilé de Mountain View. Entre le carpaccio de betterave et le sorbet au matcha, elle glisse une enveloppe : une offre de rachat à 40 fois votre ARR. « Veridix serait parfait dans notre écosystème. Nous l'appellerions Google Veridix. Puis Google Authenticity. Puis nous le fermerions, comme tout le monde. »",
        choices: [
            (label: "Résister : préparer la défense", description: "Il faut 1 000 points de « Levée de fonds » (fondateur ou CFO) en 120 jours, puis affronter Ada Rankwell en face à face. Si vous perdez, le rachat a lieu et la partie s'arrête.",
             effects: [StartTakeover("google")],
             outcome: "Vous déclinez poliment. Ada Rankwell sourit : « Alors on se reverra. Bientôt. » La défense s'organise."),
