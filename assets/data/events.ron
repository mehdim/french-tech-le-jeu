    (
        id: "rival_openai_detector", title: "OpenAI lance son propre détecteur", weight: 1.2, once: true,
        conditions: [LevelAtLeast(6), Launched],
        speaker: "Un communiqué de San Francisco",
        description: "OpenAI annonce un détecteur de texte généré par IA, gratuit et intégré à ChatGPT. Dans la démo, il reconnaît avec 100 % de certitude un texte écrit par ChatGPT… que l'on vient de lui dire avoir été écrit par ChatGPT. Vos clients PME se demandent pourquoi ils paient.",
        immediate: [CompetitorPressure(0.05)],
        choices: [
            (label: "Baisser les prix de 10 % pour garder les clients", effects: [PriceAll(-0.10), Retention(Smb, 0.05)],
             delayed: [(days: 45, chance: 0.6, effects: [Reputation(4.0), CompetitorPressure(-0.04)], text: "OpenAI retire discrètement son détecteur : il classait sa propre documentation comme « écrite par un humain fatigué ». Vos clients reviennent.")],
             outcome: "Vos prix baissent, vos clients restent. Votre CFO baisse aussi, un peu, dans son fauteuil."),
            (label: "Publier un comparatif indépendant (80 k€)", effects: [Cash(-80000.0), Reputation(3.0), ConversionBonus(Enterprise, 0.05)],
             delayed: [(days: 45, chance: 0.6, effects: [Reputation(3.0), CompetitorPressure(-0.04)], text: "OpenAI retire son détecteur « pour l'améliorer ». Votre comparatif est cité partout.")],
             outcome: "Le comparatif montre 31 points d'écart sur les textes en français. Les grands comptes l'impriment."),
            (label: "Ne rien faire", effects: [CustomersPct(Smb, -0.06)],
             outcome: "6 % de vos petits clients partent « tester la version gratuite ». Certains reviendront."),
        ],
        art: "competition",
    ),
