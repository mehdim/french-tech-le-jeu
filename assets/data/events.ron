// Bibliothèque d'événements. Les événements aléatoires sont tirés quand leurs conditions sont
// remplies (pondérés, avec délais de carence). Les événements scénarisés sont les événements
// majeurs et les enchaînements de l'histoire. Chaque choix modifie la simulation ; le texte habille la mécanique.
[
    // =================================================================
    // SCÉNARISÉS — événements majeurs des niveaux et enchaînements de l'histoire
    // =================================================================
    (
        id: "page4", scripted: true, title: "Il manque la page 4 de votre dossier",
        speaker: "France Travail",
        description: "Un courriel automatique vous informe que votre dossier de création est incomplet. Il manque la page 4. Votre dossier comporte 3 pages.",
        immediate: [AdminPoints(10.0)],
        choices: [
            (label: "Renvoyer le PDF par mail", description: "Gratuit. Mais les mails de France Travail ont un rapport compliqué avec les pièces jointes.",
             delayed: [(days: 3, chance: 0.5, effects: [AdminPoints(6.0)], text: "Votre mail est arrivé dans les spams de l'agence. Il faut tout renvoyer.")],
             outcome: "Envoyé. Vous recevez un accusé de réception de l'accusé de réception."),
            (label: "Aller à l'agence en personne", description: "Deux demi-journées perdues, mais la conseillère retrouve la page 4 dans un autre dossier.",
             effects: [Modifier(kind: ProductivityMul, value: 0.6, days: 3), AdminPoints(-8.0)],
             outcome: "La page 4 était dans le dossier de M. Duval. M. Duval a maintenant votre page 4. Et une SAS."),
            (label: "Lettre recommandée avec AR", description: "8 €. La seule technologie que l'administration reconnaît vraiment.",
             effects: [Cash(-8.0), AdminPoints(-3.0)],
             outcome: "Le facteur sonne deux fois. La page 4 est enfin réputée reçue."),
        ],
        art: "bureaucracy",
    ),
    (
        id: "are_or_arce", scripted: true, title: "ARE ou ARCE ?",
        speaker: "Votre conseillère France Travail",
        description: "Votre dossier est accepté. Deux options (simplifiées, ceci est un jeu, pas un conseil juridique) : continuer à percevoir une allocation mensuelle (sérénité personnelle), ou toucher une partie de vos droits en capital pour la société (en deux fois).",
        choices: [
            (label: "ARE : allocation mensuelle", description: "Vous dormez mieux. Productivité du fondateur +10 % (permanent).",
             effects: [FounderProductivity(1.1)],
             outcome: "Vous gardez votre allocation. Votre banquier personnel cesse de vous appeler « le startuppeur »."),
            (label: "ARCE : capital pour la boîte", description: "+9 000 € maintenant, +9 000 € dans six mois. Mais plus de filet personnel.",
             effects: [Cash(9000.0), Modifier(kind: MoraleTarget, value: -2.0, days: 90)],
             delayed: [(days: 168, chance: 1.0, effects: [Cash(9000.0)], text: "Le second versement de l'ARCE arrive. Il était prévu il y a trois semaines. On ne va pas chipoter.")],
             outcome: "9 000 € arrivent sur le compte de Veridix. Votre compte personnel, lui, observe une minute de silence."),
        ],
        art: "bureaucracy",
    ),
    (
        id: "landlord", scripted: true, title: "Le Garage devient « incubateur »",
        speaker: "Le gérant du coworking",
        description: "Le coworking se rebaptise « incubateur à impact » et augmente les loyers. Il ajoute un atelier de méditation le mardi. Obligatoire-mais-pas-obligatoire.",
        choices: [
            (label: "Accepter (+400 €/mois)", effects: [RentMonthly(400.0)],
             outcome: "Vous signez l'avenant. L'atelier méditation a lieu pendant votre daily."),
            (label: "Négocier (+150 €/mois, un peu de fatigue)", effects: [RentMonthly(150.0), FatigueAll(6.0)],
             outcome: "Après trois cafés et une heure de négociation, vous obtenez une réduction en échange d'un témoignage vidéo."),
            (label: "Menacer de partir", description: "Quitte ou double.",
             delayed: [(days: 2, chance: 0.5, effects: [RentMonthly(700.0)], text: "Le gérant ne bluffait pas : +700 €/mois. Il a trois startups d'IA sur liste d'attente.")],
             outcome: "Vous lâchez « On regarde chez la concurrence ». Il sourit. C'est mauvais signe… ou pas."),
        ],
        art: "office",
    ),
    (
        id: "projections_v7", scripted: true, title: "Prévisionnel, version 7",
        speaker: "Nathalie (Bpifrance)",
        description: "« Merci pour la version 6. Pourriez-vous ajuster les hypothèses de croissance, ajouter un scénario pessimiste, et passer le tout en format paysage ? »",
        immediate: [AdminPoints(15.0)],
        choices: [
            (label: "Refaire le prévisionnel vous-même", description: "Gratuit, mais l'équipe vous voit pleurer sur Excel.",
             effects: [MoraleAll(-2.0), FatigueAll(4.0)],
             outcome: "Version 7 envoyée. Fichier : previsionnel_v7_FINAL_vraiment.xlsx."),
            (label: "Payer un expert-comptable (2 500 €)", effects: [Cash(-2500.0), AdminPoints(-12.0)],
             outcome: "L'expert-comptable produit un prévisionnel impeccable en deux heures. Il facture huit."),
        ],
        art: "bureaucracy",
    ),
    (
        id: "web3_pivot", scripted: true, title: "« Et si on tokenisait la détection ? »",
        speaker: "Patrick Blockchain",
        description: "Patrick propose un pivot : chaque détection devient un jeton, échangeable sur une marketplace. Il est prêt à remettre 30 000 € « pour accélérer ».",
        choices: [
            (label: "Accepter le pivot Web3", description: "+30 000 €, mais votre crédibilité en prend un coup et les clients sérieux hésitent.",
             effects: [Cash(30000.0), Reputation(-8.0), Modifier(kind: ConversionMul, value: 0.85, days: 60), SetFlag("web3")],
             outcome: "VeridixChain est annoncé. Trois clients résilient. Patrick est ravi."),
            (label: "Refuser poliment", effects: [MoraleAll(4.0)],
             outcome: "L'équipe applaudit. Patrick vous envoie un mème de Satoshi déçu."),
            (label: "Compromis : un article de blog « proof-of-detection »", effects: [Reputation(-2.0), Leads(Smb, 25.0)],
             outcome: "L'article fait le buzz sur un forum crypto. Quelques leads, beaucoup de commentaires en majuscules."),
        ],
        art: "investor",
    ),
    (
        id: "free_competitor", scripted: true, title: "Un concurrent offre le même service gratuitement",
        speaker: "Le marché",
        description: "Une startup financée par un fonds américain lance un détecteur gratuit, illimité, « pour toujours ». Leur précision n'est pas publiée.",
        immediate: [CompetitorPressure(0.10)],
        choices: [
            (label: "Lancer une offre freemium", description: "Conversion PME +20 %, mais rétention un peu moins bonne et +500 €/mois d'hébergement.",
             effects: [ConversionBonus(Smb, 0.20), Retention(Smb, -0.05), HostingMonthly(500.0)],
             outcome: "Le plan gratuit attire des milliers d'utilisateurs. Certains paient. Beaucoup analysent leurs fiches Tinder."),
            (label: "Miser sur la qualité et les médias", description: "Rétention médias +8 %, réputation +2.",
             effects: [Retention(Mid, 0.08), Reputation(2.0)],
             outcome: "Vous publiez votre taux de faux positifs. Eux ne le publient pas. Les rédactions remarquent."),
            (label: "Ignorer", effects: [CustomersPct(Smb, -0.10)],
             outcome: "10 % de vos petits clients partent essayer la version gratuite. Certains reviendront."),
        ],
        art: "competition",
    ),
    (
        id: "devops_quits", scripted: true, title: "Démission en plein incident",
        speaker: "Slack, #incidents, 3h12",
        description: "La prod est en panne. Au milieu du postmortem, votre ingénieur·e DevOps poste « Je pose ma démission, bon courage » et se déconnecte. Si vous n'aviez pas de DevOps, c'est votre seul·e dev qui connaissait le cluster.",
        immediate: [Incident, QuitRole(DevOps)],
        choices: [
            (label: "Nuit blanche pour toute l'équipe", effects: [FatigueAll(15.0), Resilience(0.03)],
             outcome: "À 7h, la prod repart. Vous avez appris plus sur Kubernetes en une nuit qu'en trois ans."),
            (label: "Postmortem public et honnête", effects: [Reputation(3.0), Modifier(kind: ProductivityMul, value: 0.9, days: 7)],
             outcome: "Votre postmortem est partagé sur Hacker News. Deux SRE vous écrivent pour postuler."),
            (label: "Accuser le fournisseur cloud", effects: [Reputation(-3.0)],
             outcome: "Le fournisseur publie sa status page : tout était vert. Malaise sur LinkedIn."),
        ],
        art: "incident",
    ),
    (
        id: "benchmark_theater", scripted: true, title: "Le modèle qui passe tous les benchmarks",
        speaker: "Un concurrent (communiqué de presse)",
        description: "Un concurrent annonce un modèle qui bat tous les benchmarks publics. Sauf ceux qui ressemblent aux données de vos clients. Mais personne ne lit cette partie du papier.",
        immediate: [CompetitorPressure(0.05)],
        choices: [
            (label: "Publier une évaluation sur données clients réelles", effects: [Reputation(5.0), Leads(Mid, 10.0)],
             outcome: "Votre étude « Ce que les benchmarks ne mesurent pas » devient une référence. Les médias vous citent."),
            (label: "Optimiser pour les benchmarks publics", description: "Plus de leads à court terme, recherche détournée pendant un mois.",
             effects: [Leads(Smb, 40.0), Modifier(kind: ResearchMul, value: 0.8, days: 30)],
             outcome: "Vous gagnez 0,4 point sur un benchmark public. Vos clients ne voient aucune différence."),
        ],
        art: "research",
    ),
    (
        id: "bp_48h", scripted: true, title: "Business plan révisé sous 48 heures",
        speaker: "Le fonds Série A",
        description: "« Le comité d'investissement est lundi. On aurait besoin d'un BP révisé, avec trois scénarios et un plan d'embauche par trimestre. D'ici dimanche soir ? »",
        choices: [
            (label: "Week-end de crunch", effects: [FatigueAll(15.0), MoraleAll(-3.0)],
             outcome: "Le BP est envoyé dimanche à 23h58. Lundi matin, l'associé répond « merci, je regarde »."),
            (label: "Demander une semaine de plus", effects: [Reputation(-3.0), Modifier(kind: ConversionMul, value: 0.95, days: 14)],
             outcome: "« Pas de souci. » Vous apprendrez plus tard que deux autres startups ont rendu le leur à temps."),
            (label: "Le CFO s'en occupe", requires: [RoleAtLeast(Cfo, 1)], description: "Nécessite un·e CFO.",
             effects: [Reputation(2.0)],
             outcome: "Votre CFO livre un modèle à 47 onglets. Le fonds est impressionné. Vous ne comprenez pas l'onglet 31."),
        ],
        art: "investor",
    ),
    (
        id: "gdpr_discount", scripted: true, title: "RGPD, souveraineté et 70 % de remise",
        speaker: "Le service achats d'un grand groupe",
        description: "Un grand compte veut : conformité RGPD complète, hébergement souverain, réversibilité, audit annuel sur site… et 70 % de remise « vu le volume potentiel ».",
        choices: [
            (label: "Accepter le deal (et ses coûts)", effects: [AddCustomers(Enterprise, 1), Cash(-20000.0), Reputation(2.0)],
             outcome: "Le contrat est signé. Le volume potentiel restera potentiel."),
            (label: "Contre-proposer avec votre hébergement souverain", requires: [Shipped("sovereign_hosting")], description: "Nécessite l'hébergement souverain UE.",
             effects: [AddCustomers(Enterprise, 2), Reputation(3.0)],
             outcome: "Votre offre souveraine coche toutes les cases. Remise : 10 %. Ils signent pour deux filiales."),
            (label: "Refuser", effects: [Reputation(1.0)],
             outcome: "Vous refusez poliment. Ils reviendront dans 18 mois, avec le même cahier des charges."),
        ],
        art: "enterprise",
    ),
    (
        id: "cloud_pricing", scripted: true, title: "Nouvelle grille tarifaire du cloud",
        speaker: "Votre fournisseur cloud",
        description: "« Pour mieux vous servir », votre fournisseur cloud révise ses prix GPU pendant la semaine la plus chargée de l'année. +15 % immédiatement.",
        immediate: [InferenceCostMul(1.15)],
        choices: [
            (label: "Engagement de 3 ans (60 000 €)", requires: [CashAtLeast(70000.0)], effects: [Cash(-60000.0), InferenceCostMul(0.82)],
             outcome: "Vous signez un engagement ferme. Le commercial cloud vous envoie un panier garni."),
            (label: "Répercuter sur les prix (+10 %)", effects: [PriceAll(0.10), Modifier(kind: ChurnAdd, value: 1.5, days: 60)],
             outcome: "Les clients reçoivent un mail « Évolution de nos tarifs ». Certains répondent avec des mots durs."),
            (label: "Absorber et optimiser", effects: [Modifier(kind: ResearchMul, value: 1.15, days: 45)],
             outcome: "L'équipe R&D est piquée au vif. La vengeance passera par la quantization."),
        ],
        art: "money",
    ),
    (
        id: "infra_choice", scripted: true, title: "Hyperscaler ou infrastructure européenne ?",
        speaker: "Votre comité de direction",
        description: "Pour l'expansion européenne, il faut trancher : rester chez un hyperscaler américain (moins cher, plus simple), investir dans une infrastructure européenne (souveraine, chère), ou un hybride.",
        choices: [
            (label: "Hyperscaler américain", description: "Inférence -15 %, mais grands comptes et institutions plus réticents.",
             effects: [InferenceCostMul(0.85), ConversionBonus(Enterprise, -0.10), Reputation(-3.0), SetFlag("infra_choice"), SetFlag("infra_us")],
             outcome: "Vous signez. Un fonds souverain vous retire de sa newsletter."),
            (label: "Infrastructure européenne", requires: [CashAtLeast(90000.0)], description: "-80 000 €, +5 000 €/mois, mais conversion grands comptes +20 % et réputation +6.",
             effects: [Cash(-80000.0), HostingMonthly(5000.0), ConversionBonus(Enterprise, 0.20), Reputation(6.0), SetFlag("infra_choice"), SetFlag("infra_eu")],
             outcome: "Datacenters à Roubaix, Strasbourg et Francfort. Un ministre vous cite dans un discours."),
            (label: "Hybride", requires: [CashAtLeast(35000.0)], description: "-30 000 €, inférence -5 %, grands comptes +8 %.",
             effects: [Cash(-30000.0), InferenceCostMul(0.95), ConversionBonus(Enterprise, 0.08), SetFlag("infra_choice"), SetFlag("infra_hybrid")],
             outcome: "Les données sensibles en Europe, le reste où c'est moins cher. Votre architecte dessine un schéma avec 14 flèches."),
        ],
        art: "infrastructure",
    ),
    (
        id: "us_undercut", scripted: true, title: "Les Américains cassent les prix",
        speaker: "Le marché",
        description: "Un concurrent américain financé à hauteur de 300 M$ divise ses prix par trois en Europe. Pendant ce temps, l'appel d'offres européen que vous visez prendra neuf mois.",
        immediate: [CompetitorPressure(0.10)],
        choices: [
            (label: "Baisser vos prix de 20 %", effects: [PriceAll(-0.20), ConversionBonus(Smb, 0.10)],
             outcome: "Votre marge souffre, vos parts de marché tiennent."),
            (label: "Jouer la carte souveraineté", effects: [Reputation(3.0), Retention(Enterprise, 0.06), Retention(Mid, 0.04)],
             outcome: "« Vos données restent en Europe. » Les DPO adorent. Les acheteurs, un peu moins."),
            (label: "Porter plainte pour dumping", effects: [Cash(-20000.0), Reputation(1.0)],
             outcome: "La plainte est déposée à Bruxelles. Décision attendue en 2031."),
        ],
        art: "competition",
    ),
    (
        id: "final_decision", scripted: true, title: "Licorne, Bourse ou NVIDIA ?",
        speaker: "Vous, seul·e dans le datacenter enfin silencieux, à 23h",
        description: "Les serveurs consomment deux fois moins, la chaleur chauffe une piscine, les marges tiennent. Les banquiers, les fonds et NVIDIA attendent votre réponse. Il n'y aura pas de retour en arrière.",
        choices: [
            (label: "A. La Licorne Mondiale — Série C et hypercroissance", requires: [Flag("series_c_done"), ReputationAtLeast(45.0)], description: "Série C bouclée, réputation ≥ 45.",
             effects: [SetFlag("ending_unicorn"), SetFlag("final_choice")], outcome: "Vous signez pour devenir encore plus gros. Le communiqué est déjà prêt, en quatre langues."),
            (label: "B. L'Introduction en Bourse", requires: [Shipped("ipo_readiness")], description: "Préparation à l'IPO livrée.",
             effects: [SetFlag("ending_ipo"), SetFlag("final_choice")], outcome: "Vous signez le prospectus. Les banquiers ouvrent le livre d'ordres un mardi à 7h."),
            (label: "C. Le Rachat par NVIDIA", requires: [Flag("nvidia_interest")], description: "Avoir écouté l'offre de NVIDIA à Davos.",
             effects: [SetFlag("ending_acquisition"), SetFlag("final_choice")], outcome: "Vous signez la lettre d'intention. Une partie du prix est payée en GPU. Votre CTO pleure de joie."),
            (label: "D. La Boîte Rentable — indépendante et sobre", requires: [NetBurnAtMost(0.0)], description: "Être rentable (burn net ≤ 0).",
             effects: [SetFlag("ending_profitable"), SetFlag("final_choice")], outcome: "Vous déclinez tous les term sheets. Bernard EBITDA vous envoie des fleurs (de saison)."),
            (label: "E. Les Communs — open source et écosystème", requires: [ReputationAtLeast(60.0)], description: "Réputation ≥ 60.",
             effects: [SetFlag("ending_commons"), SetFlag("final_choice")], outcome: "Vous publiez le benchmark, les modèles et vos mesures d'énergie. Le dépôt prend 10 000 étoiles en une semaine."),
        ],
        art: "ending",
    ),
    (
        id: "cir_audit_check", scripted: true, title: "Courrier : vérification du CIR",
        speaker: "Administration fiscale",
        description: "Le CIR est remboursé… et un courrier annonce une « vérification de comptabilité » portant sur vos dépenses de recherche.",
        choices: [
            (label: "Faire préparer le dossier par un cabinet (4 000 €)", effects: [Cash(-4000.0)],
             outcome: "Le cabinet produit 300 pages de justificatifs. Le contrôle se conclut sans redressement."),
            (label: "Croiser les doigts", delayed: [(days: 60, chance: 0.35, effects: [Cash(-20000.0)], text: "Redressement partiel du CIR : 20 000 €. Le vérificateur n'a pas cru que « réunion d'alignement » était de la recherche.")],
             outcome: "Vous rangez le courrier sous une pile d'autres courriers. Stratégie éprouvée."),
        ],
        art: "bureaucracy",
    ),

    (
        id: "mentors_intro", title: "Trois mentors pour le prix d'un", scripted: true, once: true,
        speaker: "A la French",
        description: "Dans l'aviation, les systèmes critiques sont triplés pour ne jamais tomber en panne. Mehdi, Steeve et Jean-Baptiste, qui refont le monde chaque semaine dans A la French, proposent de faire pareil avec Veridix : trois mentors. Tous les trois répondront quand vous les appellerez (panneau Mentors, touche M), mais l'un d'eux sera votre mentor principal : son conseil revient deux fois plus vite.",
        choices: [
            (label: "Mehdi, pour les APIs et l'écosystème",
             description: "Bonus : conversion grands comptes +8 %, ETI +5 %, réputation +5.",
             effects: [ChooseMentor("mehdi")],
             outcome: "Mehdi : « Première règle : si ça n'a pas d'API, ça n'existe pas. »"),
            (label: "Steeve, pour l'infra et l'inférence",
             description: "Bonus : coût d'inférence -12 %, résilience +5 %.",
             effects: [ChooseMentor("steeve")],
             outcome: "Steeve : « Montre-moi ta facture GPU. Non, la vraie. »"),
            (label: "Jean-Baptiste, pour l'open source et la souveraineté",
             description: "Bonus : réputation +8, moral +4, rétention grands comptes +3 %.",
             effects: [ChooseMentor("jb")],
             outcome: "Jean-Baptiste : « Bien. On commence par mettre un cône de chantier dans le bureau. »"),
        ],
        art: "people",
    ),

    // =================================================================
    // NIVEAUX 12 À 16 — scénarisés
    // =================================================================
    (
        id: "licorne_gala", scripted: true, title: "La soirée des licornes",
        speaker: "Un magazine économique",
        description: "Vous êtes invité·e à la « Nuit des Licornes » au Palais Brongniart : smoking obligatoire, photo avec un ministre, et un classement des startups « les plus prometteuses » établi par un cabinet qui est aussi client de la moitié d'entre elles.",
        choices: [
            (label: "Y aller et faire un discours (30 000 € de table)", effects: [Cash(-30000.0), Reputation(4.0), Modifier(kind: LeadMul, value: 1.15, days: 60)],
             outcome: "Votre discours fait rire la salle. Surtout la blague sur France Travail. Un ministre la reprend le lendemain à la radio."),
            (label: "Envoyer le CFO et rester coder", effects: [Reputation(1.0), Modifier(kind: ProductivityMul, value: 1.05, days: 30)],
             outcome: "Le CFO revient avec un trophée en plexiglas et trois cartes de visite de banquiers. L'équipe livre deux fonctionnalités."),
            (label: "Organiser une contre-soirée « Les Poneys » à Belleville", effects: [Cash(-5000.0), MoraleAll(6.0), Reputation(2.0)],
             outcome: "Kebab, karaoké et démos en direct. Trois journalistes quittent la soirée officielle pour venir. La photo du poney gonflable fait le tour de LinkedIn."),
        ],
        art: "marketing",
    ),
    (
        id: "ex_employees_competitor", scripted: true, title: "Les anciens lancent « Veridupe »",
        speaker: "TechCrunch",
        description: "Deux de vos meilleurs ingénieurs démissionnent le même lundi. Le mardi, ils annoncent « Veridupe », « la détection d'IA, mais en mieux », avec 20 M$ levés auprès d'un fonds de Sand Hill Road. Leur démo ressemble beaucoup à votre roadmap. Même les fautes de frappe.",
        immediate: [QuitRole(Backend), QuitRole(AiResearcher), Counter("ex_competitors", 2), CompetitorPressure(0.06)],
        choices: [
            (label: "Procès pour concurrence déloyale (400 000 €)", requires: [CashAtLeast(500000.0)],
             effects: [Cash(-400000.0)],
             delayed: [(days: 90, chance: 0.55, effects: [CompetitorPressure(-0.06), Reputation(2.0)], text: "Le juge californien donne raison à Veridix : Veridupe doit retirer trois modules. Leur fonds commence à paniquer.")],
             outcome: "Vos avocats de Palo Alto adorent le dossier. Ils facturent 1 400 $ de l'heure pour vous le dire."),
            (label: "Augmenter toute l'équipe de 8 % pour éviter d'autres départs", effects: [SalaryPct(0.08), MoraleAll(8.0)],
             outcome: "Plus personne ne part. Le CFO, lui, commence à fumer."),
            (label: "Les ignorer et livrer plus vite", effects: [Modifier(kind: ProductivityMul, value: 1.1, days: 60), Modifier(kind: MoraleTarget, value: -3.0, days: 60)],
             delayed: [(days: 120, chance: 0.5, effects: [Cash(-3000000.0), CompetitorPressure(-0.08), AddCustomers(Enterprise, 6)], text: "Veridupe à court de cash : vous rachetez leurs clients et leur code pour 3 M€. Les deux anciens reviennent… comme consultants.")],
             outcome: "« La meilleure réponse, c'est le produit. » Le produit est d'accord, l'équipe un peu moins."),
        ],
        art: "competition",
    ),
    (
        id: "espionage_affair", scripted: true, title: "La clé USB en forme de panda",
        speaker: "Votre RSSI",
        description: "Une clé USB « oubliée » dans la salle de réunion de Shanghai a été branchée sur un poste de l'équipe recherche. Elle contenait un joli fond d'écran et un logiciel qui l'était beaucoup moins. Les poids du modèle ont peut-être été copiés.",
        choices: [
            (label: "Audit forensique complet et rotation de tous les secrets (350 000 €)", requires: [CashAtLeast(400000.0)],
             effects: [Cash(-350000.0), Resilience(0.05), Modifier(kind: ProductivityMul, value: 0.92, days: 21)],
             outcome: "Trois semaines d'enquête, 12 000 mots de passe changés, et un panda placé sous scellés."),
