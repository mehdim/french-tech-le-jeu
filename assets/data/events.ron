            (label: "Expliquer que les révolutionnaires étaient très en avance", effects: [Reputation(-4.0), Counter("stock", -3), Counter("scandals_handled", 1)], delayed: [(days: 26, chance: 1.0, effects: [TriggerEvent("scandal_carbon")], text: "")],
             outcome: "Trois historiens répondent dans une tribune au Monde. Leur tribune est classée « 62 % IA »."),
            (label: "Accuser une version de test déployée par un stagiaire", effects: [Reputation(-2.0), MoraleAll(-4.0), Counter("scandals_handled", 1)], delayed: [(days: 26, chance: 1.0, effects: [TriggerEvent("scandal_carbon")], text: "")],
