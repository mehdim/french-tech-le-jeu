// Les mentors d'A la French. Le mentor principal est choisi au début de la
// campagne (événement « mentors_intro ») : son bonus permanent s'applique une
// fois, et on peut le consulter deux fois plus souvent que les autres
// (toutes les 7 semaines au lieu de 14).
// Une consultation donne le PREMIER conseil dont les conditions sont remplies ;
// le dernier conseil de chaque liste est sans condition.
[
    (
        id: "mehdi", name: "Mehdi",
        title: "Fondateur d'APIdays · APIs, écosystèmes et business",
        bio: "Il a vu passer toutes les plateformes d'API de la planète. Il vous répète qu'un produit sans API est un PowerPoint, et qu'un écosystème vaut mieux qu'une campagne de pub.",
        skills: ["APIs & plateformes", "Écosystème & partenariats", "Business & levées"],
        passive: [ConversionBonus(Enterprise, 0.08), ConversionBonus(Mid, 0.05), Reputation(5.0)],
        passive_label: "Conversion grands comptes +8 %, ETI +5 %, réputation +5",
        cooldown_main: 49, cooldown: 98,
        advice: [
            (conditions: [Shipped("mvp_text"), NotShipped("mvp_api")],
             text: "Sans API, ton produit est une démo. Livre l'endpoint : ce sont les développeurs qui feront ta distribution.",
             effects: [Modifier(kind: ProductivityMul, value: 1.1, days: 21), Reputation(1.0)]),
            (conditions: [Shipped("mvp_api"), NotShipped("docs")],
             text: "Ta doc, c'est ton premier commercial. Un endpoint sans doc, c'est un endpoint que personne n'appelle.",
             effects: [Modifier(kind: ConversionMul, value: 1.12, days: 45), Leads(Smb, 20.0)]),
            (conditions: [SegmentCustomersAtLeast(Enterprise, 1), NotShipped("sso")],
             text: "Les grands comptes ne signeront pas sans SSO. Ce n'est pas glamour, c'est le ticket d'entrée.",
             effects: [ConversionBonus(Enterprise, 0.05), Leads(Enterprise, 3.0)]),
            (conditions: [LevelAtLeast(4), NotFlag("mehdi_angels")],
             text: "Je te présente deux business angels qui ont vraiment construit des boîtes. Pas Jean-Michel.",
             effects: [SetFlag("mehdi_angels"), Reputation(4.0), Leads(Mid, 12.0)]),
            (conditions: [LevelAtLeast(8)],
             text: "Organise ton propre événement d'écosystème. Les clients viennent pour les talks, ils restent pour l'API.",
             effects: [Cash(-8000.0), Leads(Enterprise, 6.0), Leads(Mid, 15.0), Reputation(3.0)]),
            (conditions: [LevelAtLeast(13), MarketOpened("us"), Not(CounterAtLeast("hires_us", 4))],
             text: "À San Francisco, personne n'achète à un bureau vide. Recrute sur place, et fais venir tes clients européens aux meetups : un écosystème, ça s'exporte.",
             effects: [Leads(Enterprise, 5.0), Modifier(kind: SalesMul, value: 1.1, days: 45)]),
            (conditions: [LevelAtLeast(15), Not(CounterAtLeast("state_deals", 3))],
             text: "À Davos, ne vends pas un produit, vends une infrastructure de confiance. Les chefs d'État achètent des écosystèmes, pas des features.",
             effects: [Reputation(3.0)]),
            (conditions: [],
             text: "Parle à tes clients. Vraiment. Pas à ton dashboard.",
             effects: [Retention(Smb, 0.02), Reputation(1.0)]),
        ],
    ),
    (
        id: "steeve", name: "Steeve",
        title: "Entrepreneur tech · mobile, infra et inférence IA",
        bio: "Il a fait tourner des apps pour des millions de gens et ne supporte pas une milliseconde gâchée. Pour lui, la moitié de votre facture GPU est un bug.",
        skills: ["Inférence & performance", "Infra & GPU", "Produit grand public"],
        passive: [InferenceCostMul(0.88), Resilience(0.05)],
        passive_label: "Coût d'inférence -12 %, résilience +5 %",
        cooldown_main: 49, cooldown: 98,
        advice: [
            (conditions: [Launched, NotShipped("monitoring")],
             text: "Pas de monitoring ? Donc tu apprends tes pannes par tes clients. Branche des sondes avant la prochaine.",
             effects: [Resilience(0.05), Modifier(kind: IncidentRiskMul, value: 0.7, days: 60)]),
            (conditions: [TechDebtAtLeast(40.0)],
             text: "Ta dette technique, c'est un emprunt à taux variable. Bloque une semaine pour rembourser, sinon c'est elle qui te bloque.",
             effects: [TechDebt(-6.0), Modifier(kind: ProductivityMul, value: 0.9, days: 7)]),
            (conditions: [Shipped("finetune_v1"), NotShipped("quantization")],
             text: "Quantize-moi ça en int8. Tu perds trois dixièmes de point, tu divises la facture.",
             effects: [InferenceCostMul(0.94)]),
            (conditions: [Launched, PayingCustomersAtLeast(30), Not(GrossMarginAtLeast(65.0))],
             text: "Ta marge part en GPU. Regroupe les requêtes, mets les résultats en cache, arrête de payer deux fois la même inférence.",
             effects: [InferenceCostMul(0.92), TaskSetback(0.03)]),
            (conditions: [LevelAtLeast(9)],
             text: "Sors du cloud généraliste pour l'inférence chaude. Des GPU dédiés, bien remplis, coûtent trois fois moins.",
             effects: [InferenceCostMul(0.9), HostingMonthly(1500.0)]),
            (conditions: [Flag("own_datacenters"), Not(EnergyReducedBy(0.5))],
             text: "Ta facture d'électricité, c'est ta dette technique qui se voit depuis l'espace. Élague le modèle avant d'acheter des ventilateurs.",
             effects: [Modifier(kind: ResearchMul, value: 1.15, days: 45), EnergyMul(0.97)]),
            (conditions: [LevelAtLeast(13), NotShipped("agent_copilot")],
             text: "Des agents qui lisent tout, c'est génial. Calcule d'abord combien coûte un agent qui lit tout. Puis divise par dix.",
             effects: [InferenceCostMul(0.95)]),
            (conditions: [],
             text: "Mesure avant d'optimiser. Puis optimise quand même.",
             effects: [InferenceCostMul(0.97), Modifier(kind: ProductivityMul, value: 1.05, days: 14)]),
        ],
    ),
    (
        id: "jb", name: "Jean-Baptiste",
        title: "Président de VideoLAN · open source, vidéo et souveraineté",
        bio: "Il a fait installer VLC sur des milliards de machines sans un euro de publicité. Il croit à l'open source, au logiciel européen et aux cônes de chantier.",
        skills: ["Open source & communauté", "Souveraineté numérique", "Recrutement d'ingénieurs"],
        passive: [Reputation(8.0), MoraleAll(4.0), Retention(Enterprise, 0.03)],
        passive_label: "Réputation +8, moral +4, rétention grands comptes +3 %",
        cooldown_main: 49, cooldown: 98,
        advice: [
            (conditions: [EmployeesAtLeast(2), MoraleBelow(50.0)],
             text: "Ton équipe est cuite. Personne n'a jamais livré un bon logiciel en burn-out. Renvoie tout le monde chez soi vendredi.",
             effects: [MoraleAll(6.0), FatigueAll(-10.0)]),
            (conditions: [Launched, NotFlag("sdk_open")],
             text: "Publie ton SDK en open source. Tu ne perds rien, et tes clients pourront enfin l'auditer.",
             effects: [SetFlag("sdk_open"), Reputation(5.0), Leads(Smb, 30.0), CompetitorPressure(0.02)]),
            (conditions: [Unlocked("recruitment"), EmployeesBelow(6)],
             text: "Recrute dans l'open source : regarde qui corrige vraiment des bugs, pas qui a le plus d'étoiles sur GitHub.",
             effects: [MoraleAll(3.0), Reputation(2.0)]),
            (conditions: [SegmentCustomersAtLeast(Enterprise, 1), NotShipped("sovereign_hosting")],
             text: "Les administrations veulent savoir où sont leurs données. Héberge en Europe, et dis-le.",
             effects: [Retention(Enterprise, 0.04), ConversionBonus(Enterprise, 0.04)]),
            (conditions: [LevelAtLeast(11)],
             text: "Il y a huit strates de souveraineté numérique. Commence par celle que tu contrôles : ton code.",
             effects: [Reputation(4.0), Retention(Enterprise, 0.03)]),
            (conditions: [LevelAtLeast(14), MarketOpened("cn"), NotFlag("zero_trust")],
             text: "En Chine, cloisonne tout. Pas par paranoïa : par hygiène. Et ne branche jamais une clé USB offerte, même en forme de panda.",
             effects: [Resilience(0.03), Reputation(1.0)]),
            (conditions: [LevelAtLeast(16)],
             text: "Publie tes chiffres d'énergie. Tous. Les mauvais aussi. La transparence, c'est la meilleure souveraineté.",
             effects: [Reputation(4.0), MoraleAll(2.0)]),
            (conditions: [],
             text: "Fais un logiciel qui marche, qui ne ment pas et qui ne revend pas les données. Le reste suit.",
             effects: [Reputation(2.0), Fpr(-0.3)]),
        ],
    ),
]
